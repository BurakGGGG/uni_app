rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı Fonksiyonlar ──────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSafeUserCreate() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'email',
        'photoUrl',
        'isVerifiedStudent',
        'university',
        'universityId',
        'department',
        'grade',
        'bio',
        'role',
        'reviewCount',
        'notificationPrefs',
        'createdAt',
        'lastLoginAt'
      ]) &&
      request.resource.data.email == request.auth.token.email &&
      request.resource.data.role == 'user' &&
      request.resource.data.reviewCount == 0 &&
      request.resource.data.isVerifiedStudent == false &&
      request.resource.data.university == null &&
      request.resource.data.universityId == null;
    }

    function isSafeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'photoUrl',
        'department',
        'grade',
        'bio',
        'notificationPrefs'
      ]);
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isValidReviewContent(data) {
      return data.rating is number &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.categoryRatings is map &&
        data.categoryRatings.keys().size() <= 12 &&
        data.comment is string &&
        data.comment.size() >= 20 &&
        data.comment.size() <= 500 &&
        data.pros is list &&
        data.pros.size() <= 10 &&
        data.cons is list &&
        data.cons.size() <= 10 &&
        data.imageUrls is list &&
        data.imageUrls.size() <= 3 &&
        data.isAnonymous is bool;
    }

    function isValidReviewAuthorFields(data) {
      return (
          (data.isAnonymous == true &&
            data.userName == 'Anonim Öğrenci' &&
            data.userPhotoUrl == null) ||
          (data.isAnonymous == false &&
            data.userName == currentUserProfile().displayName &&
            data.userPhotoUrl == currentUserProfile().photoUrl)
        ) &&
        data.userUniversity == currentUserProfile().university;
    }

    function isSafeReviewOwnerUpdate() {
      return isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userName',
          'userPhotoUrl',
          'userUniversity',
          'rating',
          'categoryRatings',
          'comment',
          'pros',
          'cons',
          'imageUrls',
          'isAnonymous',
          'isApproved',
          'updatedAt'
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.universityId == resource.data.universityId &&
        request.resource.data.likes == resource.data.likes &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.isApproved == false &&
        request.resource.data.updatedAt == request.time &&
        isValidReviewContent(request.resource.data) &&
        isValidReviewAuthorFields(request.resource.data);
    }

    function isValidPreferenceItems(items) {
      return items is list &&
        items.size() <= 24;
    }

    function isValidPreferenceListContent(data) {
      return data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 80 &&
        data.description is string &&
        data.description.size() <= 500 &&
        data.isPublic is bool &&
        isValidPreferenceItems(data.items);
    }

    function isValidPreferenceListAuthor(data) {
      return data.userName is string &&
        data.userName.size() > 0 &&
        data.userName.size() <= 120 &&
        (
          data.userPhotoUrl == null ||
          (data.userPhotoUrl is string && data.userPhotoUrl.size() <= 2048)
        );
    }

    function isSafePreferenceListCreate() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'userName',
          'userPhotoUrl',
          'title',
          'description',
          'isPublic',
          'shareSlug',
          'viewCount',
          'items',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'userId',
          'userName',
          'userPhotoUrl',
          'title',
          'description',
          'isPublic',
          'shareSlug',
          'viewCount',
          'items',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.shareSlug is string &&
        request.resource.data.shareSlug.matches('[a-z0-9]{8}') &&
        request.resource.data.viewCount == 0 &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        isValidPreferenceListAuthor(request.resource.data) &&
        isValidPreferenceListContent(request.resource.data);
    }

    function isSafePreferenceListOwnerUpdate() {
      return isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'isPublic',
          'items',
          'updatedAt'
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.userName == resource.data.userName &&
        request.resource.data.userPhotoUrl == resource.data.userPhotoUrl &&
        request.resource.data.shareSlug == resource.data.shareSlug &&
        request.resource.data.viewCount == resource.data.viewCount &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is timestamp &&
        isValidPreferenceListContent(request.resource.data);
    }

    // ─── Şehirler ───────────────────────────────────────────────
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Üniversiteler ──────────────────────────────────────────
    match /universities/{uniId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bölümler ───────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Mekanlar ───────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bildirimler ────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // ─── Yorumlar ───────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.isApproved == true
        || (request.auth != null && request.auth.uid == resource.data.userId);

      allow create: if false;

      allow update: if isSafeReviewOwnerUpdate();

      allow delete: if isOwner(resource.data.userId);
    }

    match /reviews/{reviewId}/likes/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.isApproved == true &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt == request.time;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /suspiciousActivityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /preferenceLists/{listId} {
      allow read: if resource.data.isPublic == true ||
                     (request.auth != null && request.auth.uid == resource.data.userId);

      allow create: if isAuthenticated() && isSafePreferenceListCreate();

      allow update: if isSafePreferenceListOwnerUpdate();

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isSafeUserCreate();
      allow update: if isOwner(userId) && isSafeUserUpdate();
      allow delete: if isOwner(userId);
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0 &&
        request.resource.data.token.size() <= 4096;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/favorites/{favId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    match /users/{userId}/likedReviews/{reviewId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.isApproved == true &&
        request.resource.data.keys().hasOnly(['createdAt', 'reviewId']) &&
        request.resource.data.reviewId == reviewId &&
        request.resource.data.createdAt == request.time;
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Karşılaştırma Geçmişi ───────────────────────────────
    // Plus/Pro kullanıcı için saklanır. Sadece sahibi okuyabilir ve yazabilir.
    // Subscription tier kontrolü client tarafında yapılır (server-side enforcement
    // gerekmez — listeye yazma sınırlı sayıda, abuse riski düşük).
    match /users/{userId}/comparisonHistory/{historyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.type in ['university', 'department', 'city'] &&
        request.resource.data.entityAId is string &&
        request.resource.data.entityBId is string &&
        request.resource.data.entityAName is string &&
        request.resource.data.entityBName is string;
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Karşılaştırma Notları ─────────────────────────────────
    // Pro kullanıcı için kişisel notlar. Sadece sahibi CRUD yapabilir.
    // Subscription tier kontrolü client tarafında yapılır.
    match /users/{userId}/comparisonNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.comparisonType in ['university', 'department', 'city'] &&
        request.resource.data.entityAId is string &&
        request.resource.data.entityBId is string &&
        request.resource.data.note is string &&
        request.resource.data.note.size() > 0 &&
        request.resource.data.note.size() <= 500;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['note', 'pros', 'cons', 'rating', 'updatedAt']) &&
        request.resource.data.note is string &&
        request.resource.data.note.size() > 0 &&
        request.resource.data.note.size() <= 500;
      allow delete: if isOwner(userId);
    }
    match /recommendationEnrichments/{cacheId} {
      allow read: if isAuthenticated() &&
                     cacheId.matches(request.auth.uid + '_.*') &&
                     resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ─── Kullanım İstatistikleri (Sıkı validation) ───────────────
    match /users/{uid}/usageStats/{docId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'dailyComparisons',
          'dailyAiComparisons',
          'dailyAiRecommendations',
          'lastResetDate',
          'totalComparisons'
        ]) &&
        request.resource.data.dailyComparisons == 0 &&
        request.resource.data.dailyAiComparisons == 0 &&
        request.resource.data.dailyAiRecommendations == 0 &&
        request.resource.data.totalComparisons == 0 &&
        request.resource.data.lastResetDate is string &&
        request.resource.data.lastResetDate.matches('\\d{4}-\\d{2}-\\d{2}');

      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['dailyComparisons', 'lastResetDate', 'totalComparisons']) &&
        (
          (request.resource.data.dailyComparisons == resource.data.dailyComparisons + 1) ||
          (request.resource.data.dailyComparisons == 0)
        ) &&
        request.resource.data.totalComparisons >= resource.data.totalComparisons &&
        request.resource.data.totalComparisons <= resource.data.totalComparisons + 1 &&
        request.resource.data.lastResetDate is string &&
        request.resource.data.lastResetDate.matches('\\d{4}-\\d{2}-\\d{2}');

      allow delete: if false;
    }

    // ─── AI Özet Cache ───────────────────────────────────────────
    match /aiSummaryCache/{cacheKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── AI Özet Logları ────────────────────────────────────────
    match /aiSummaryLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Hikayeler (Admin Story) ────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Mekan Önerileri ─────────────────────────────────────────
    match /place_suggestions/{suggestionId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      // submitPlaceSuggestion ve performPlaceSuggestionAction yazar.
      allow create, update, delete: if false;
    }

    // ─── Geri Bildirim (Feedback) ──────────────────────────────
    // Client yazımı kapalıdır; submitFeedback callable function yazar.
    match /feedback/{feedbackId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ─── Webhook Events (Idempotency) ───────────────────────────
    // Sadece admin SDK (Cloud Function) yazar, kimse okuyamaz/yazamaz.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── Analytics Counter'ları ─────────────────────────────────
    // Cloud Functions/Admin SDK yazar. Client yalnızca admin ise okuyabilir.
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
  }
}
