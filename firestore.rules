rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı Fonksiyonlar ──────────────────────────────────

    // Kullanıcı giriş yapmış mı?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin kontrolü (seed verisi yüklemek için)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Kullanıcı edu.tr doğrulanmış öğrenci mi? (Doğrudan Auth Token'dan)
    function isVerifiedStudent() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.matches('.*\\.edu\\.tr$');
    }

    // Belgenin sahibi bu kullanıcı mı?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Şehirler ───────────────────────────────────────────────
    // Herkes okuyabilir, kimse yazamaz (admin panelden yönetilir)
    match /cities/{cityId} {
      allow read: if true;
      allow write: if true;
    }

    // ─── Üniversiteler ──────────────────────────────────────────
    // Herkes okuyabilir, kimse yazamaz (admin panelden yönetilir)
    match /universities/{uniId} {
      allow read: if true;
      allow write: if true; // TEMP: was isAdmin()
    }

    // ─── Bölümler ───────────────────────────────────────────────
    // Herkes okuyabilir, kimse yazamaz (admin panelden yönetilir)
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    // ─── Mekanlar (Places) ──────────────────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bildirimler (Notifications) ────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // create sadece Cloud Function tarafından yapılır (admin)
      allow create: if false;
    }

    // ─── Yorumlar ───────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Onaylı yorumlar herkese açık, onaysız yorumu sadece sahibi görebilir
      allow read: if resource.data.isApproved == true
        || (request.auth != null && request.auth.uid == resource.data.userId);

      // Sadece doğrulanmış öğrenciler kendi üniversitelerine yorum yazabilir
      allow create: if isVerifiedStudent() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.universityId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.universityId;

      // Yorum sahibi: tüm alanları düzenleyebilir (userId dışında)
      // Başkaları: sadece 'likes' sayacını değiştirebilir (beğenme/beğenmeme için)
      allow update: if isAuthenticated() && (
        // Yorum sahibi: userId aynı kalmalı
        (isOwner(resource.data.userId) &&
         request.resource.data.userId == resource.data.userId) ||
        // Başkaları: sadece likes alanını değiştirebilir, diğer her şey sabit
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
      );

      // Sadece kendi yorumunu silebilir
      allow delete: if isOwner(resource.data.userId);
    }

    // ─── Likes Subcollection ──────────────────────────────────
    // Her kullanıcı kendi like kaydını oluşturabilir/silebilir
    match /reviews/{reviewId}/likes/{userId} {
      allow read: if true;
      allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      allow update: if false;
    }

    // ─── Raporlar / Şikayetler ───────────────────────────────────
    match /reports/{reportId} {
      allow read: if false;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Kullanıcılar ───────────────────────────────────────────
    match /users/{userId} {
      // Herkes profil bilgilerini okuyabilir
      allow read: if true;

      // Sadece kendi profilini oluşturabilir
      allow create: if isOwner(userId);

      // Sadece kendi profilini güncelleyebilir, isVerifiedStudent için token kontrolü zorunludur
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerifiedStudent']) ||
        (request.resource.data.isVerifiedStudent == true && request.auth.token.email_verified == true && request.auth.token.email.matches('.*\\.edu\\.tr$')) ||
        (request.resource.data.isVerifiedStudent == false)
      );

      // Profil silme: sadece kendi hesabı
      allow delete: if isOwner(userId);
    }

    // ─── Favoriler ──────────────────────────────────────────────
    match /users/{userId}/favorites/{favId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ─── Beğenilen Yorumlar (denormalize) ────────────────────────
    match /users/{userId}/likedReviews/{reviewId} {
      allow read: if isOwner(userId);
      allow create, delete: if isOwner(userId);
      allow update: if false;
    }
  }
}
