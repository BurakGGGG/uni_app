rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcı Fonksiyonlar ──────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function hasVerifiedEduEmail() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.matches('.*\\.edu\\.tr$');
    }

    function isVerifiedStudent() {
      return hasVerifiedEduEmail();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSafeUserCreate() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'email',
        'photoUrl',
        'isVerifiedStudent',
        'university',
        'universityId',
        'department',
        'grade',
        'bio',
        'role',
        'reviewCount',
        'notificationPrefs',
        'createdAt',
        'lastLoginAt'
      ]) &&
      request.resource.data.email == request.auth.token.email &&
      request.resource.data.role == 'user' &&
      request.resource.data.reviewCount == 0 &&
      request.resource.data.isVerifiedStudent == false &&
      request.resource.data.university == null &&
      request.resource.data.universityId == null;
    }

    function isSafeUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName',
        'photoUrl',
        'department',
        'grade',
        'bio',
        'notificationPrefs'
      ]);
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isValidReviewTypeAndTarget(data) {
      return (data.type == 'university' ||
              data.type == 'department' ||
              data.type == 'place') &&
        data.targetId is string &&
        data.targetId.size() > 0 &&
        data.targetId.size() <= 128 &&
        data.universityId is string &&
        data.universityId.size() > 0 &&
        data.universityId.size() <= 128 &&
        (data.type != 'university' || data.targetId == data.universityId);
    }

    function isValidReviewContent(data) {
      return data.rating is number &&
        data.rating >= 1 &&
        data.rating <= 5 &&
        data.categoryRatings is map &&
        data.categoryRatings.keys().size() <= 12 &&
        data.comment is string &&
        data.comment.size() >= 20 &&
        data.comment.size() <= 500 &&
        data.pros is list &&
        data.pros.size() <= 10 &&
        data.cons is list &&
        data.cons.size() <= 10 &&
        data.imageUrls is list &&
        data.imageUrls.size() <= 3 &&
        data.isAnonymous is bool;
    }

    function isValidReviewAuthorFields(data) {
      return (
          (data.isAnonymous == true &&
            data.userName == 'Anonim Öğrenci' &&
            data.userPhotoUrl == null) ||
          (data.isAnonymous == false &&
            data.userName == currentUserProfile().displayName &&
            data.userPhotoUrl == currentUserProfile().photoUrl)
        ) &&
        data.userUniversity == currentUserProfile().university;
    }

    function isSafeReviewCreate() {
      return request.resource.data.keys().hasOnly([
          'type',
          'targetId',
          'universityId',
          'userId',
          'userName',
          'userPhotoUrl',
          'userUniversity',
          'rating',
          'categoryRatings',
          'comment',
          'pros',
          'cons',
          'imageUrls',
          'likes',
          'isAnonymous',
          'isApproved',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'type',
          'targetId',
          'universityId',
          'userId',
          'userName',
          'userPhotoUrl',
          'userUniversity',
          'rating',
          'categoryRatings',
          'comment',
          'pros',
          'cons',
          'imageUrls',
          'likes',
          'isAnonymous',
          'isApproved',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.universityId == currentUserProfile().universityId &&
        request.resource.data.likes == 0 &&
        request.resource.data.isApproved == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        isValidReviewTypeAndTarget(request.resource.data) &&
        isValidReviewContent(request.resource.data) &&
        isValidReviewAuthorFields(request.resource.data);
    }

    function isSafeReviewOwnerUpdate() {
      return isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userName',
          'userPhotoUrl',
          'userUniversity',
          'rating',
          'categoryRatings',
          'comment',
          'pros',
          'cons',
          'imageUrls',
          'isAnonymous',
          'isApproved',
          'updatedAt'
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.targetId == resource.data.targetId &&
        request.resource.data.universityId == resource.data.universityId &&
        request.resource.data.likes == resource.data.likes &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.isApproved == false &&
        request.resource.data.updatedAt == request.time &&
        isValidReviewContent(request.resource.data) &&
        isValidReviewAuthorFields(request.resource.data);
    }

    // ─── Şehirler ───────────────────────────────────────────────
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Üniversiteler ──────────────────────────────────────────
    match /universities/{uniId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bölümler ───────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Mekanlar ───────────────────────────────────────────────
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Bildirimler ────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // ─── Yorumlar ───────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.isApproved == true
        || (request.auth != null && request.auth.uid == resource.data.userId);

      allow create: if isVerifiedStudent() && isSafeReviewCreate();

      allow update: if isAdmin() || isSafeReviewOwnerUpdate();

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /reviews/{reviewId}/likes/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.isApproved == true &&
        request.resource.data.keys().hasOnly(['createdAt']) &&
        request.resource.data.createdAt == request.time;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /preferenceLists/{listId} {
      allow read: if resource.data.isPublic == true ||
                     (request.auth != null && request.auth.uid == resource.data.userId);

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.items.size() <= 24;

      allow update: if (request.auth != null && request.auth.uid == resource.data.userId)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isSafeUserCreate();
      allow update: if isOwner(userId) && isSafeUserUpdate();
      allow delete: if isOwner(userId);
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/fcmTokens/{tokenId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['token', 'platform', 'createdAt', 'updatedAt']) &&
        request.resource.data.token is string &&
        request.resource.data.token.size() > 0 &&
        request.resource.data.token.size() <= 4096;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/favorites/{favId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    match /users/{userId}/likedReviews/{reviewId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        get(/databases/$(database)/documents/reviews/$(reviewId)).data.isApproved == true &&
        request.resource.data.keys().hasOnly(['createdAt', 'reviewId']) &&
        request.resource.data.reviewId == reviewId &&
        request.resource.data.createdAt == request.time;
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Karşılaştırma Geçmişi ───────────────────────────────
    // Plus/Pro kullanıcı için saklanır. Sadece sahibi okuyabilir ve yazabilir.
    // Subscription tier kontrolü client tarafında yapılır (server-side enforcement
    // gerekmez — listeye yazma sınırlı sayıda, abuse riski düşük).
    match /users/{userId}/comparisonHistory/{historyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.type in ['university', 'department', 'city'] &&
        request.resource.data.entityAId is string &&
        request.resource.data.entityBId is string &&
        request.resource.data.entityAName is string &&
        request.resource.data.entityBName is string;
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ─── Karşılaştırma Notları ─────────────────────────────────
    // Pro kullanıcı için kişisel notlar. Sadece sahibi CRUD yapabilir.
    // Subscription tier kontrolü client tarafında yapılır.
    match /users/{userId}/comparisonNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.comparisonType in ['university', 'department', 'city'] &&
        request.resource.data.entityAId is string &&
        request.resource.data.entityBId is string &&
        request.resource.data.note is string &&
        request.resource.data.note.size() > 0 &&
        request.resource.data.note.size() <= 500;
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['note', 'pros', 'cons', 'rating', 'updatedAt']) &&
        request.resource.data.note is string &&
        request.resource.data.note.size() > 0 &&
        request.resource.data.note.size() <= 500;
      allow delete: if isOwner(userId);
    }
    match /recommendationEnrichments/{cacheId} {
      allow read: if isAuthenticated() &&
                     cacheId.matches(request.auth.uid + '_.*') &&
                     resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ─── Kullanım İstatistikleri (Sıkı validation) ───────────────
    match /users/{uid}/usageStats/{docId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) &&
        request.resource.data.dailyComparisons == 0 &&
        request.resource.data.totalComparisons == 0;

      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['dailyComparisons', 'lastResetDate', 'totalComparisons']) &&
        (
          (request.resource.data.dailyComparisons == resource.data.dailyComparisons + 1) ||
          (request.resource.data.dailyComparisons == 0)
        ) &&
        request.resource.data.totalComparisons >= resource.data.totalComparisons &&
        request.resource.data.totalComparisons <= resource.data.totalComparisons + 1 &&
        request.resource.data.lastResetDate is string &&
        request.resource.data.lastResetDate.matches('\\d{4}-\\d{2}-\\d{2}');

      allow delete: if false;
    }

    // ─── AI Özet Cache ───────────────────────────────────────────
    match /aiSummaryCache/{cacheKey} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── AI Özet Logları ────────────────────────────────────────
    match /aiSummaryLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Hikayeler (Admin Story) ────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Geri Bildirim (Feedback) ──────────────────────────────
    // Giriş yapmış kullanıcılar geri bildirim oluşturabilir.
    // Yalnızca admin tüm geri bildirimleri okuyabilir/yönetebilir.
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.type in ['bug', 'suggestion', 'other'];
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ─── Webhook Events (Idempotency) ───────────────────────────
    // Sadece admin SDK (Cloud Function) yazar, kimse okuyamaz/yazamaz.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── Analytics Counter'ları ─────────────────────────────────
    // Herhangi bir giriş yapmış kullanıcı event yazabilir (increment).
    // Sadece admin'ler tüm istatistikleri okuyabilir.
    // Hem analytics/counters hem analytics/daily_* dokümanlarını kapsar.
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();

      match /items/{itemId} {
        allow read: if isAdmin();
        allow write: if isAuthenticated();
      }
    }
  }
}
