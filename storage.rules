rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isJpegUpload() {
      return request.resource.size > 0
        && request.resource.contentType == 'image/jpeg';
    }

    function isReviewImageName(imageId) {
      return imageId.matches('^[A-Za-z0-9_-]+\\.jpg$');
    }

    function isPlaceSuggestionId(suggestionId) {
      return suggestionId.matches('^[A-Za-z0-9_-]{1,256}$');
    }

    function isPlaceSuggestionImageName(fileName) {
      return fileName.matches('^photo_[0-4]\\.(jpg|jpeg|png|webp)$');
    }

    function isPlaceSuggestionImageUpload() {
      return request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
    }

    function isStoryMediaUpload() {
      return request.resource.size > 0
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
          || request.resource.contentType == 'image/gif'
          || request.resource.contentType == 'image/heic'
          || request.resource.contentType == 'image/heif'
          || request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/quicktime'
          || request.resource.contentType == 'video/webm'
        );
    }

    // ─── Profil Fotoğrafları ─────────────────────────────────
    match /profile_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && isJpegUpload();
    }

    // ─── Yorum Fotoğrafları (Sprint 3) ───────────────────────
    match /review_images/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isReviewImageName(imageId)
        && request.resource.size < 10 * 1024 * 1024
        && isJpegUpload();
    }

    // ─── Mekan Öneri Fotoğrafları ─────────────────────────────
    match /place_suggestions/{userId}/{suggestionId}/{fileName} {
      allow read: if true;
      // Onay sonrası görsel değiştirmeyi önlemek için client yalnızca oluşturur.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == userId
        && isPlaceSuggestionId(suggestionId)
        && isPlaceSuggestionImageName(fileName)
        && isPlaceSuggestionImageUpload();
      allow update, delete: if false;
    }

    // ─── Story Medyaları (Admin) ────────────────────────────
    match /stories/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 100 * 1024 * 1024
        && isStoryMediaUpload();
      allow delete: if isAdmin();
    }
  }
}
